# Copy to .env.local and fill in. `npx convex dev` writes the Convex lines for you.

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (dashboard → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# These live in Convex, not here — set them with `npx convex env set NAME value`:
#   CLERK_JWT_ISSUER_DOMAIN     your Clerk Frontend API URL, e.g. https://example.clerk.accounts.dev
#   MUX_TOKEN_ID                Mux access token (Video read + write)
#   MUX_TOKEN_SECRET
#   CLOUDFLARE_TURN_KEY_ID      optional: a call relay for strict networks
#   CLOUDFLARE_TURN_API_TOKEN   optional
